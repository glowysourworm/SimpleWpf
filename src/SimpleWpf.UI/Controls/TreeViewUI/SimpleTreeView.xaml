<UserControl x:Class="SimpleWpf.UI.Controls.TreeViewUI.SimpleTreeView"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:treeviewUI="clr-namespace:SimpleWpf.UI.Controls.TreeViewUI"
             xmlns:selectors="clr-namespace:SimpleWpf.UI.Controls.TreeViewUI.Selectors"
             xmlns:converters="clr-namespace:SimpleWpf.UI.Converter"
             xmlns:convertersTreeviewUI="clr-namespace:SimpleWpf.UI.Converter.TreeViewUI">
    
    <UserControl.Resources>
        
        <!-- Converters -->
        <converters:BoolVisibilityCollapseConverter x:Key="BoolVisibilityCollapseConverter" />
        <converters:BoolInverseVisibilityCollapseConverter x:Key="BoolInverseVisibilityCollapseConverter" />
        <converters:CollectionNonEmptyVisibilityConverter x:Key="CollectionNonEmptyVisibilityConverter" />
        <convertersTreeviewUI:TreeViewItemMarginConverter x:Key="TreeViewItemMarginConverter" />
       
        <!-- Selectors -->
        <selectors:SimpleTreeViewItemContainerStyleSelector x:Key="SimpleTreeViewItemContainerStyleSelector" />
        <selectors:SimpleTreeViewItemTemplateSelector x:Key="SimpleTreeViewItemTemplateSelector" />
        <selectors:SimpleTreeViewItemExpanderTemplateSelector x:Key="SimpleTreeViewItemExpanderTemplateSelector" />

        <!-- List Box Style (need selectors to be able to use these recursively -->
        <Style TargetType="ListBox" x:Key="SimpleTreeViewListBoxStyle">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="ItemTemplateSelector" Value="{StaticResource SimpleTreeViewItemTemplateSelector}" />
            <Setter Property="ItemContainerStyleSelector" Value="{StaticResource SimpleTreeViewItemContainerStyleSelector}" />
        </Style>

        <!-- Item Container Style-->
        <Style TargetType="ListBoxItem" x:Key="SimpleTreeViewItemContainerStyle">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="FontStyle" Value="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            
            <!-- DATA BINDING (must align with the view model)-->
            <Setter Property="IsSelected" Value="{Binding NodeValue.IsSelected, Mode=TwoWay}" />
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Margin}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Toggle Button Templates -->
        <DataTemplate x:Key="SimpleTreeViewItemExpanderOpenTemplate">
            <Grid Background="Transparent">

                <ContentPresenter ContentTemplate="{Binding ItemExpanderOpenTemplate, RelativeSource={RelativeSource AncestorType={x:Type treeviewUI:SimpleTreeView}}}"
                                                            Visibility="{Binding NodeValue.IsExpanded, NotifyOnSourceUpdated=True, Converter={StaticResource BoolVisibilityCollapseConverter}}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SimpleTreeViewItemExpanderClosedTemplate">
            <Grid Background="Transparent">

                <ContentPresenter ContentTemplate="{Binding ItemExpanderClosedTemplate, RelativeSource={RelativeSource AncestorType={x:Type treeviewUI:SimpleTreeView}}}"
                                                            Visibility="{Binding NodeValue.IsExpanded, NotifyOnSourceUpdated=True, Converter={StaticResource BoolInverseVisibilityCollapseConverter}}" />
            </Grid>
        </DataTemplate>        

        <!-- Item Template -->
        <DataTemplate x:Key="SimpleTreeViewItemTemplate">

            <Grid RowDefinitions="Auto, *" Margin="0" VerticalAlignment="Center">

                <!-- Header -->
                <Border x:Name="HeaderBorder"
                        Grid.Row="0"
                        Padding="0"
                        Margin="0"
                        BorderThickness="0"
                        BorderBrush="Transparent"
                        HorizontalAlignment="Stretch">

                    <Grid ColumnDefinitions="Auto, *" Margin="0" VerticalAlignment="Center" Background="Transparent">

                        <!-- Expander -->
                        <ToggleButton x:Name="InputFileExpanderButton"
                                      Grid.Column="0"
                                      Margin="0"
                                      Padding="0"
                                      ClickMode="Release"      
                                      Background="Transparent"                                      
                                      Checked="InputFileExpanderButton_Checked"
                                      Unchecked="InputFileExpanderButton_Unchecked"
                                      ContentTemplateSelector="{StaticResource SimpleTreeViewItemExpanderTemplateSelector}"
                                      IsChecked="{Binding NodeValue.IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding Children, Converter={StaticResource CollectionNonEmptyVisibilityConverter}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <TextBlock Text="{Binding}"
                                   Grid.Column="1"
                                   Padding="0"
                                   Margin="{Binding ItemPadding, RelativeSource={RelativeSource AncestorType={x:Type treeviewUI:SimpleTreeView}}}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   TextBlock.TextAlignment="Left">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NodeValue.ToggleExpansionCommand}" MouseAction="LeftDoubleClick" />
                            </TextBlock.InputBindings>                            
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Items -->
                <ListBox x:Name="LeafLB"
                         Grid.Row="1" 
                         Margin="{Binding ItemIndent, RelativeSource={RelativeSource AncestorType={x:Type treeviewUI:SimpleTreeView}}, Converter={StaticResource TreeViewItemMarginConverter}}"
                         BorderThickness="0"
                         BorderBrush="Transparent"
                         ItemsSource="{Binding Children}"
                         Style="{StaticResource SimpleTreeViewListBoxStyle}"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.CanContentScroll="False"                         
                         VirtualizingPanel.IsVirtualizing="True"
                         Visibility="{Binding NodeValue.IsExpanded, Converter={StaticResource BoolVisibilityCollapseConverter}}">
                </ListBox>
            </Grid>

            <DataTemplate.Triggers>

                <!-- Alteration -->
                <!--Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter TargetName="HeaderBorder" Property="Background" Value="{Binding ItemBackground, RelativeSource={RelativeSource AncestorType={x:Type treeviewUI:SimpleTreeView}}}" />
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter TargetName="HeaderBorder" Property="Background" Value="{Binding ItemBackgroundAlternation, RelativeSource={RelativeSource AncestorType={x:Type treeviewUI:SimpleTreeView}}}" />
                </Trigger-->

                <Trigger Property="IsMouseOver" Value="True" SourceName="HeaderBorder">
                    <Setter TargetName="HeaderBorder" Property="Background" Value="{Binding ItemHoverBrush, RelativeSource={RelativeSource AncestorType={x:Type treeviewUI:SimpleTreeView}}}" />
                </Trigger>
                <DataTrigger Binding="{Binding NodeValue.IsSelected}" Value="True">
                    <Setter TargetName="HeaderBorder" Property="Background" Value="{Binding ItemSelectionBrush, RelativeSource={RelativeSource AncestorType={x:Type treeviewUI:SimpleTreeView}}}" />
                </DataTrigger>
            </DataTemplate.Triggers>

        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer x:Name="TheScrollViewer" CanContentScroll="False"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  BorderBrush="{Binding BorderBrush, ElementName=BaseControl}"
                  BorderThickness="{Binding BorderThickness, ElementName=BaseControl}">
        <Grid>

            <ListBox x:Name="TheTreeView" 
                     ItemsSource="{Binding ItemsSource, ElementName=BaseControl}"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.CanContentScroll="False"
                     SelectionMode="Extended"
                     Style="{StaticResource SimpleTreeViewListBoxStyle}">
            </ListBox>

        </Grid>
    </ScrollViewer>
</UserControl>
