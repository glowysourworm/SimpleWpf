<UserControl x:Class="SimpleWpf.UI.Controls.EnumUI.SimpleEnumRadioButtons"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SimpleWpf.UI.Converter">

    <UserControl.Resources>
        <converters:EnumObservableCollectionConverter x:Key="EnumObservableCollectionConverter" />
    </UserControl.Resources>

    <ItemsControl x:Name="EnumList"
                  ItemsSource="{Binding EnumType, Converter={StaticResource EnumObservableCollectionConverter}, ElementName=BaseControl}">
        
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <RadioButton Margin="0, 0, 0, 5" 
                             GroupName="EnumGroup" 
                             Content="{Binding Name}" 
                             ToolTip="{Binding Description}"
                             IsChecked="{Binding IsChecked, Mode=TwoWay}">
                </RadioButton>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
