<UserControl x:Class="SimpleWpf.UI.Controls.EnumUI.SimpleEnumComboBox"
             x:Name="BaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SimpleWpf.UI.Converter">

    <UserControl.Resources>
        <converters:BoolVisibilityCollapseConverter x:Key="BoolVisibilityCollapseConverter" />
        <converters:EnumObservableCollectionConverter x:Key="EnumObservableCollectionConverter" />
    </UserControl.Resources>

    <ComboBox x:Name="TheComboBox"
              SelectionChanged="TheComboBox_SelectionChanged"
              SelectedIndex="0"
              Cursor="Hand"               
              ItemsSource="{Binding EnumType, Converter={StaticResource EnumObservableCollectionConverter}, ElementName=BaseControl}">
        
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <Border Cursor="Hand">
                    <Grid Background="Transparent" 
                          Margin="2" 
                          ToolTip="{Binding Description}">
                        <ContentPresenter Content="{Binding Name}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ComboBox.ItemTemplate>
        
    </ComboBox>
</UserControl>

    